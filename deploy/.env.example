# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，不要提交
# 注意：密码等敏感信息只写在 .env，不要写进任何源码或 SQL 文件

# ---- MySQL（服务器已有实例，宿主端口 3307）----
MYSQL_HOST=your-server-ip
MYSQL_PORT=3307
MYSQL_DB=jobfit
MYSQL_USER=
MYSQL_PASSWORD=

# 初始化数据库时用（只执行一次，之后不要填在代码里）
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=

# ---- Redis（服务器已有实例，宿主端口 6380）----
REDIS_HOST=your-server-ip
REDIS_PORT=6380
REDIS_PASSWORD=

# ---- MinIO（服务器已有实例，9000/9001）----
MINIO_ENDPOINT=http://your-server-ip:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_RESUME=jobfit-resume
MINIO_BUCKET_EXPORT=jobfit-export

# ---- 应用 ----
APP_DOMAIN=jobfit.example.com
AGENT_TOKEN_TTL_DAYS=90
APPLY_DAILY_LIMIT_DEFAULT=30
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
